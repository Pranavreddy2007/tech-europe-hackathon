# ── Agent: Gemini via Pydantic AI (required) ─────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=low
# Alternative to GEMINI_API_KEY: route through the Pydantic AI Gateway
PYDANTIC_AI_GATEWAY_API_KEY=

# ── Database (SQLite by default; any Postgres URL works) ────────────────
DATABASE_URL=sqlite+aiosqlite:///./govmind.db
# DATABASE_URL=postgresql://user:pass@host:5432/govmind

# ── Telegram (recommended; token from @BotFather) ───────────────────────
TELEGRAM_BOT_TOKEN=
# Optional: DAO group chat id. Otherwise learned when the bot is added to a group.
TELEGRAM_GROUP_ID=
# Public URL of this backend; the Telegram webhook registers itself on startup.
PUBLIC_BASE_URL=

# ── WhatsApp Cloud API (optional; demo mode when empty) ─────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=govmind-verify
WHATSAPP_APP_SECRET=
# Comma-separated numbers that always receive DAO broadcasts
WHATSAPP_BROADCAST_NUMBERS=

# ── Endless Chain (optional; a testnet account is generated if empty) ───
ENDLESS_PRIVATE_KEY=
ENDLESS_NETWORK=testnet

# ── Misc ─────────────────────────────────────────────────────────────────
SCHEDULED_CHECKS_ENABLED=false
