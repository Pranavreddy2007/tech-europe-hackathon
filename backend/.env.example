# Gemini (via Pydantic AI). Alternatively set PYDANTIC_AI_GATEWAY_API_KEY.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
PYDANTIC_AI_GATEWAY_API_KEY=

# Database (defaults to local SQLite; use Postgres in production)
# DATABASE_URL=postgresql://user:pass@host:5432/govmind
DATABASE_URL=sqlite+aiosqlite:///./govmind.db

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=govmind-verify
WHATSAPP_APP_SECRET=your_app_secret
# Optional: comma-separated numbers that always receive DAO broadcasts
WHATSAPP_BROADCAST_NUMBERS=

# Endless Chain (on-chain writes are disabled without a key)
ENDLESS_PRIVATE_KEY=your_endless_private_key_here
ENDLESS_NETWORK=testnet

# Server
PUBLIC_BASE_URL=
SCHEDULED_CHECKS_ENABLED=false
